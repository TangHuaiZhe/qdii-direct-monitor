.page { padding: 20rpx; }
.state { margin-top: 20rpx; padding: 80rpx 24rpx; border-radius: 26rpx; background: #fff; color: #68736b; text-align: center; }
.state.error { color: #aa3838; }
.hero { padding: 34rpx 28rpx; border-radius: 30rpx; background: linear-gradient(135deg, #143d2c, #1d6747); color: #fff; }
.code { padding: 6rpx 12rpx; border-radius: 10rpx; background: rgba(255,255,255,.13); font-family: monospace; font-size: 21rpx; font-weight: 700; }
.name { margin: 22rpx 0 10rpx; font-size: 39rpx; line-height: 1.3; font-weight: 800; }
.meta { color: #dceddf; font-size: 22rpx; line-height: 1.5; }
.hero-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx 10rpx; margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.15); }
.hero-metrics view { display: flex; flex-direction: column; color: rgba(255,255,255,.66); font-size: 19rpx; line-height: 1.4; }
.hero-value { margin-bottom: 4rpx; color: #fff; font-size: 32rpx; font-weight: 850; font-variant-numeric: tabular-nums; }
.hero-value.premium-high { color: #ffb3ba; }
.hero-value.premium-elevated { color: #ffdca0; }
.hero-value.premium-normal { color: #fff; }
.hero-value.premium-discount { color: #b6ecd1; }
.hero-value.premium-unknown { color: #e4ebe6; font-size: 26rpx; }
.carry { margin-top: 20rpx; padding: 14rpx 16rpx; border: 1rpx dashed rgba(255,255,255,.5); border-radius: 14rpx; background: rgba(255,255,255,.08); color: #ffe3e6; font-size: 20rpx; line-height: 1.5; }
.degraded { margin-top: 20rpx; padding: 18rpx 22rpx; border: 1rpx solid #efdfb7; border-radius: 22rpx; background: #fff9ea; color: #71571c; font-size: 21rpx; line-height: 1.55; }
.card { margin-top: 20rpx; padding: 26rpx 24rpx; border: 1rpx solid #e1e7e2; border-radius: 26rpx; background: #fff; }
.section-title { color: #19221d; font-size: 31rpx; font-weight: 800; }
.hint { margin-top: 10rpx; color: #7a857e; font-size: 21rpx; line-height: 1.55; }
.fact-line { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #edf0ed; color: #52605a; font-size: 21rpx; line-height: 1.5; }
.source-row { margin-top: 18rpx; }
.source-kind { color: #68736b; font-size: 21rpx; font-weight: 650; }
.source { margin: 10rpx 0 0; padding: 0 16rpx; height: 58rpx; line-height: 58rpx; border-radius: 13rpx; background: #eef4f0; color: #416352; font-size: 20rpx; text-align: left; }
.disclaimer { padding: 26rpx 12rpx 10rpx; color: #7a857e; font-size: 21rpx; line-height: 1.65; }
