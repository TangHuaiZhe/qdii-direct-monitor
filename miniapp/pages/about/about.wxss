.page { padding: 20rpx; }.hero { padding: 36rpx 30rpx; border-radius: 30rpx; background: linear-gradient(135deg,#143d2c,#1d6747); color: #dceddf; font-size: 24rpx; }.title { margin-bottom: 12rpx; color: #fff; font-size: 43rpx; font-weight: 800; }.card { margin-top: 20rpx; padding: 27rpx 24rpx; border: 1rpx solid #e1e7e2; border-radius: 25rpx; background: #fff; }.heading { margin-bottom: 14rpx; color: #19221d; font-size: 30rpx; font-weight: 800; }.copy { color: #5f6b63; font-size: 24rpx; line-height: 1.7; }.grade-row { display: flex; align-items: flex-start; gap: 14rpx; margin: 14rpx 0; color: #5f6b63; font-size: 23rpx; line-height: 1.5; }.grade { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; font-size: 20rpx; font-weight: 800; }.a { background: #e5f5ed; color: #137552; }.b { background: #eaf2fb; color: #2b66a0; }.c { background: #fff3d6; color: #9b6400; }.d { background: #edf0ed; color: #667068; }.website { margin: 22rpx 0 0; border-radius: 16rpx; background: #eef4f0; color: #416352; font-size: 23rpx; }.disclaimer { padding: 28rpx 14rpx 10rpx; color: #7a857e; font-size: 21rpx; line-height: 1.6; text-align: center; }
