.page { padding: 20rpx; }.state { margin-top: 20rpx; padding: 80rpx 24rpx; border-radius: 26rpx; background: #fff; color: #68736b; text-align: center; }.state.error { color: #aa3838; }
.hero { padding: 34rpx 28rpx; border-radius: 30rpx; background: linear-gradient(135deg, #143d2c, #1d6747); color: #fff; }.code { padding: 6rpx 12rpx; border-radius: 10rpx; background: rgba(255,255,255,.13); font-family: monospace; font-size: 21rpx; font-weight: 700; }.name { margin: 22rpx 0 10rpx; font-size: 39rpx; line-height: 1.3; font-weight: 800; }.meta { color: #dceddf; font-size: 22rpx; }.hero-metrics { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10rpx; margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.15); }.hero-metrics view { display: flex; flex-direction: column; color: rgba(255,255,255,.66); font-size: 19rpx; }.hero-value { margin-bottom: 4rpx; color: #fff; font-size: 28rpx; font-weight: 800; }
.card { margin-top: 20rpx; padding: 26rpx 24rpx; border: 1rpx solid #e1e7e2; border-radius: 26rpx; background: #fff; }.section-title { color: #19221d; font-size: 31rpx; font-weight: 800; }.hint { margin-top: 7rpx; color: #7a857e; font-size: 21rpx; line-height: 1.5; }.observation { margin-top: 22rpx; padding: 22rpx 20rpx; border: 1rpx solid #e6ebe7; border-radius: 22rpx; background: #fbfcfb; }.observation-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.relation { margin-right: 10rpx; padding: 4rpx 9rpx; border-radius: 7rpx; background: #e8f3ed; color: #137552; font-size: 18rpx; font-weight: 700; }.channel { color: #27332c; font-size: 24rpx; font-weight: 650; }.status { flex: 0 0 auto; padding: 5rpx 10rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 700; }.status-open { background: #e5f5ed; color: #137552; }.status-limited { background: #fff3d6; color: #9b6400; }.status-suspended,.status-unavailable { background: #fdeaea; color: #aa3838; }.status-unknown { background: #edf0ed; color: #667068; }.amount { margin: 20rpx 0 13rpx; color: #19221d; font-size: 39rpx; font-weight: 850; }.evidence { display: flex; align-items: flex-start; gap: 10rpx; }.grade { flex: 0 0 auto; padding: 3rpx 9rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 750; }.grade-A { background: #e5f5ed; color: #137552; }.grade-B { background: #eaf2fb; color: #2b66a0; }.grade-C { background: #fff3d6; color: #9b6400; }.grade-D { background: #edf0ed; color: #667068; }.reason,.notes { color: #68736b; font-size: 20rpx; line-height: 1.5; }.notes { margin-top: 9rpx; }.source { margin: 16rpx 0 0; padding: 0 16rpx; height: 58rpx; line-height: 58rpx; border-radius: 13rpx; background: #eef4f0; color: #416352; font-size: 20rpx; text-align: left; }
.fee-total { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: #68736b; font-size: 22rpx; }.fee-value { color: #19221d; font-size: 37rpx; font-weight: 850; }.fee-low { color: #137552; }.fee-normal { color: #9b6400; }.fee-high { color: #aa3838; }.fee-tag { padding: 4rpx 10rpx; border-radius: 999rpx; font-size: 18rpx; }.fee-tag-low { background: #e5f5ed; color: #137552; }.fee-tag-normal { background: #fff3d6; color: #9b6400; }.fee-tag-high { background: #fdeaea; color: #aa3838; }.fee-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; margin: 20rpx 0; padding: 18rpx 0; border-top: 1rpx solid #edf0ed; border-bottom: 1rpx solid #edf0ed; }.fee-grid view { display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid #edf0ed; color: #7a857e; font-size: 19rpx; }.fee-grid view:last-child { border: 0; }.fee-grid view text:first-child { margin-bottom: 4rpx; color: #28332c; font-size: 27rpx; font-weight: 750; }.disclaimer { padding: 26rpx 12rpx 10rpx; color: #7a857e; font-size: 21rpx; line-height: 1.65; }
